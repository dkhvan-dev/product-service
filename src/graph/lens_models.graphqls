"Модель линз"
type LensModel {
    "Идентификатор модели линз"
    id: Int!

    "Дата добавления модели линз"
    createdAt: Time!

    "Автор добавления модели линз"
    createdBy: Int!

    "Название модели линз"
    name: String!

    "Доступна модель линз?"
    isAvailable: Boolean!
}